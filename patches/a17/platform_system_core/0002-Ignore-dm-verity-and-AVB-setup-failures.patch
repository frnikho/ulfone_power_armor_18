From 8b70c712a99c8f29553e8a2b0a01170747ea0af2 Mon Sep 17 00:00:00 2001
From: nico <31937059+frnikho@users.noreply.github.com>
Date: Sun, 1 Nov 2026 22:27:02 +0100
Subject: [PATCH] Ignore dm-verity and AVB setup failures

Port of TrebleDroid trebledroid/platform_system_core/0012 onto LineageOS 24
(the SetUpDmVerity call now sits inside an fs_mgr_flags.avb check).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01NAP5WhrNfcHujA9XUfYqLY
Change-Id: I8908aa6881b0405e4318e7c198ec681ab3505da0
---
 init/first_stage_init.cpp             | 6 +++++-
 init/first_stage_mount.cpp            | 1 -
 init/first_stage_mount_microdroid.cpp | 7 +++++++
 3 files changed, 12 insertions(+), 2 deletions(-)

diff --git a/init/first_stage_init.cpp b/init/first_stage_init.cpp
index 8b94699..aa651f0 100644
--- a/init/first_stage_init.cpp
+++ b/init/first_stage_init.cpp
@@ -543,7 +543,11 @@ int FirstStageMain(int argc, char** argv) {
         }
 
         if (!created_devices && !fsm->DoCreateDevices()) {
-            LOG(FATAL) << "Failed to create devices required for first stage mount";
+            LOG(ERROR) << "Failed to create devices required for first stage mount, retrying without avb";
+            fsm = CreateFirstStageMount(cmdline + " no_vbmeta");
+            if(!fsm->DoCreateDevices()) {
+                LOG(FATAL) << "Failed to create devices required for first stage mount, retrying without avb";
+            }
         } else if (REBOOT_BOOTLOADER_ON_PANIC && !AttemptingToBootNewSlot()) {
             InstallRebootSignalHandlers();
         }
diff --git a/init/first_stage_mount.cpp b/init/first_stage_mount.cpp
index 8134a1e..ee98637 100644
--- a/init/first_stage_mount.cpp
+++ b/init/first_stage_mount.cpp
@@ -206,7 +206,6 @@ bool FirstStageMount::MountPartition(const Fstab::iterator& begin, bool erase_sa
     if (begin->fs_mgr_flags.avb) {
         if (!SetUpDmVerity(&(*begin))) {
             PLOG(ERROR) << "Failed to setup verity for '" << begin->mount_point << "'";
-            return false;
         }
     } else {
         LOG(INFO) << "AVB is not enabled, skip verity setup for '" << begin->mount_point << "'";
diff --git a/init/first_stage_mount_microdroid.cpp b/init/first_stage_mount_microdroid.cpp
index 7ec5e2a..cf3547d 100644
--- a/init/first_stage_mount_microdroid.cpp
+++ b/init/first_stage_mount_microdroid.cpp
@@ -41,6 +41,13 @@ static Result<Fstab> ReadFirstStageFstabMicrodroid(const std::string& cmdline) {
 
 Result<std::unique_ptr<FirstStageMount>> FirstStageMount::Create(const std::string& cmdline) {
     Result<Fstab> fstab = ReadFirstStageFstabMicrodroid(cmdline);
+
+    if (cmdline.find("no_vbmeta") != std::string::npos) {
+        for(auto& part: *fstab) {
+            part.avb_keys = "";
+            part.fs_mgr_flags.avb = false;
+        }
+    }
     if (!fstab.ok()) {
         return fstab.error();
     }
-- 
2.56.0

