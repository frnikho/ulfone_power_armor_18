From 2d3b4a8f65a466cb48f7546df3ddfad51d4e17e3 Mon Sep 17 00:00:00 2001
From: nico <31937059+frnikho@users.noreply.github.com>
Date: Mon, 2 Nov 2026 18:32:47 +0100
Subject: [PATCH] CarrierConfig: enable VoLTE and VoWiFi for Free (carrier id
 1958)

Free Mobile supports VoLTE and VoWiFi, but the AOSP config leaves
carrier_volte_available_bool false, so the MediaTek ImsService refuses
to register (volteCfg:false).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01NAP5WhrNfcHujA9XUfYqLY
Change-Id: I6544d8566b4af7393a54ca72feeaa8f77a9887ac
---
 assets/carrier_config_carrierid_1958_Free.xml | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/assets/carrier_config_carrierid_1958_Free.xml b/assets/carrier_config_carrierid_1958_Free.xml
index 2520c30..1241218 100644
--- a/assets/carrier_config_carrierid_1958_Free.xml
+++ b/assets/carrier_config_carrierid_1958_Free.xml
@@ -1,5 +1,13 @@
 <?xml version="1.0" encoding="utf-8" standalone="yes"?>
 <carrier_config>
+    <boolean name="carrier_volte_available_bool" value="true"/>
+    <boolean name="editable_enhanced_4g_lte_bool" value="true"/>
+    <boolean name="hide_enhanced_4g_lte_bool" value="false"/>
+    <boolean name="enhanced_4g_lte_on_by_default_bool" value="true"/>
+    <boolean name="carrier_wfc_ims_available_bool" value="true"/>
+    <boolean name="editable_wfc_mode_bool" value="true"/>
+    <boolean name="carrier_default_wfc_ims_enabled_bool" value="false"/>
+    <boolean name="carrier_vt_available_bool" value="false"/>
     <boolean name="show_4g_for_lte_data_icon_bool" value="true"/>
     <int name="maxImageHeight" value="1944"/>
     <int name="maxMessageSize" value="614400"/>
-- 
2.56.0

