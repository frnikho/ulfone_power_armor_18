-            } catch (Exception e) {
-                Log.e(TAG, "Failed to connect to guest service", e);
-            }
-            if (binder != null) {
-                mGuestService = IAiSealOdimPayloadService.Stub.asInterface(binder);
-                sLock.notifyAll();
-            } else {
