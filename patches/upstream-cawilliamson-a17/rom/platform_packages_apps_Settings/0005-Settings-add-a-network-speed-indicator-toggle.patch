diff --git a/src/com/android/settings/network/NetworkTrafficPreferenceController.kt b/src/com/android/settings/network/NetworkTrafficPreferenceController.kt
new file mode 100644
--- /dev/null
+++ b/src/com/android/settings/network/NetworkTrafficPreferenceController.kt
@@ -0,0 +1,45 @@
+package com.android.settings.network
+
+import android.content.Context
+import android.provider.Settings
+import androidx.annotation.VisibleForTesting
+import com.android.settings.R
+import com.android.settings.core.TogglePreferenceController
+
+/**
+ * Preference controller that turns the network speed indicator in the status bar on or off. The
+ * indicator itself lives in SystemUI and follows [Settings.System.NETWORK_TRAFFIC_ENABLED].
+ */
+class NetworkTrafficPreferenceController(context: Context, key: String) :
+    TogglePreferenceController(context, key) {
+
+    override fun getAvailabilityStatus(): Int {
+        return AVAILABLE
+    }
+
+    override fun isChecked(): Boolean {
+        return Settings.System.getInt(
+            mContext.contentResolver,
+            Settings.System.NETWORK_TRAFFIC_ENABLED,
+            SETTING_VALUE_OFF,
+        ) == SETTING_VALUE_ON
+    }
+
+    override fun setChecked(isChecked: Boolean): Boolean {
+        return Settings.System.putInt(
+            mContext.contentResolver,
+            Settings.System.NETWORK_TRAFFIC_ENABLED,
+            if (isChecked) SETTING_VALUE_ON else SETTING_VALUE_OFF,
+        )
+    }
+
+    override fun getSliceHighlightMenuRes(): Int {
+        return R.string.menu_key_network
+    }
+
+    companion object {
+        @VisibleForTesting const val SETTING_VALUE_OFF = 0
+
+        @VisibleForTesting const val SETTING_VALUE_ON = 1
+    }
+}
